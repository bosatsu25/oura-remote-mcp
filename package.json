{
  "name": "oura-remote-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Personal, single-user remote MCP server that exposes read-only Oura Ring sleep/readiness/heart-rate data to Claude. Not affiliated with Oura.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:workers",
    "test:unit": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:workers": "vitest run --config vitest.config.ts",
    "lint:secrets": "gitleaks detect --source . --no-banner",
    "keygen": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "^0.33.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.157.0"
  }
}
