# Copy to .dev.vars for local `npm run dev`. NEVER commit .dev.vars.
# Production values are set with `npx wrangler secret put <NAME>`.

# Overrides of wrangler.jsonc vars for local dev.
PUBLIC_BASE_URL=http://localhost:8787
# Your numeric GitHub id: curl https://api.github.com/users/<login>  (field "id")
ALLOWED_GITHUB_USER_ID=

# GitHub OAuth App (identity gate). Use a separate dev app; callback URL: http://localhost:8787/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Oura application (https://developer.ouraring.com/applications).
# Redirect URI: <PUBLIC_BASE_URL>/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# 32 random bytes, base64. Generate with: npm run keygen
TOKEN_ENCRYPTION_KEY=
