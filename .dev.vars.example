# Copy to .dev.vars for local `wrangler dev`. NEVER commit .dev.vars.
# Production values are set with `wrangler secret put <NAME>`.

# GitHub OAuth App (identity gate). Callback URL: <PUBLIC_BASE_URL>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Oura application (https://developer.ouraring.com/applications).
# Redirect URI: <PUBLIC_BASE_URL>/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# 32 random bytes, base64. Generate with: npm run keygen
TOKEN_ENCRYPTION_KEY=
